# Google Gemini API Key
# Få din API-nøkkel fra: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=din-api-nøkkel-her

# PIN-gate for tilgangskontroll (valgfritt)
# Hvis satt, må brukere oppgi denne PIN-koden for å bruke tjenesten
# La stå tom eller fjern for å deaktivere PIN-gate
PINGATE_CODE=din-pin-kode-her
